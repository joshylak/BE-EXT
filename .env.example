# Postgres connection string
# e.g. postgres://user:password@host:5432/dbname
# Add ?sslmode=require if your provider needs SSL (Render, Railway, Supabase, Neon, etc.)
DATABASE_URL=

# Set to "true" if your Postgres provider requires SSL but doesn't put it in the URL
PG_SSL=false

# Secret used to sign auth tokens issued after a successful password check
JWT_SECRET=

# How long an issued token stays valid (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=30d

# Shared passcode guests/planners use to unlock the app (plain text, case-insensitive)
# Prefer SEATING_PASSWORD_HASH (bcrypt hash) in production instead.
SEATING_PASSWORD=
SEATING_PASSWORD_HASH=

# Port the API listens on
PORT=4000

# Comma-separated list of allowed origins for CORS (your deployed frontend URL(s))
CORS_ORIGIN=http://localhost:5173
